#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        connection {
            bindings = <&mo 2>;
            key-positions = <59 60>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp ESC                     &kp N1    &kp N2    &kp N3        &kp N4                 &kp N5                                            &kp N6         &kp N7  &kp N8     &kp N9   &kp N0            &kp EQUAL
&kp TAB                     &kp Q     &kp W     &kp E         &kp R                  &kp T                                             &kp Y          &kp U   &kp I      &kp O    &kp P             &kp GRAVE
&mt LS(LC(LEFT_ALT)) ENTER  &kp A     &kp S     &kp D         &kp F                  &kp G                 &kp LS(LG(S))  &kp MINUS    &kp H          &kp J   &kp K      &kp L    &lt 3 SEMI        &kp SQT
&kp LSHFT                   &kp Z     &kp X     &kp C         &kp V                  &kp B                 &kp BACKSPACE  &kp DELETE   &kp N          &kp M   &kp COMMA  &kp DOT  &kp SLASH         &kp BACKSLASH
&kp LCTRL                   &kp LGUI  &kp LALT  &lt 2 DELETE  &mt LSHIFT LANGUAGE_2  &mt LCTRL LANGUAGE_1  &lt 1 SPACE    &lt 1 ENTER  &kp BACKSPACE  &none   &none      &none    &kp LEFT_BRACKET  &kp RIGHT_BRACKET
            >;
        };

        arrow_and_num {
            bindings = <
&trans  &kp F1           &kp F2       &kp F3    &kp F4     &kp F5                               &kp F6      &kp F7  &kp F8  &kp F9  &kp F10   &kp F11
&trans  &kp PAGE_UP      &kp HOME     &kp UP    &kp END    &kp PAGE_DOWN                        &kp GRAVE   &kp N7  &kp N8  &kp N9  &kp N0    &kp F12
&trans  &kp LC(LEFT)     &kp LEFT     &kp DOWN  &kp RIGHT  &kp LC(RIGHT)  &kp LG(L)  &kp MINUS  &kp PERIOD  &kp N4  &kp N5  &kp N6  &kp SEMI  &kp APOS
&trans  &kp LS(LA(TAB))  &kp LS(TAB)  &kp ESC   &kp TAB    &kp LA(TAB)    &trans     &trans     &kp N0      &kp N1  &kp N2  &kp N3  &kp FSLH  &kp BSLH
&trans  &trans           &trans       &trans    &trans     &trans         &trans     &trans     &trans      &none   &none   &none   &kp LBKT  &kp RBKT
            >;
        };

        connection {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                   &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                  &trans  &trans  &trans  &trans  &trans  &trans
&sys_reset      &trans         &out OUT_BLE   &trans         &out OUT_USB   &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&bootloader     &trans         &trans         &trans         &trans         &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans         &trans         &trans         &trans         &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &none   &none           &none     &none            &none   &none
&trans  &trans  &trans  &trans  &trans  &trans                  &none   &mkp MB4        &trans    &mkp MB5         &none   &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &mkp MB1        &mkp MB3  &mkp MB2         &trans  &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &msc SCRL_LEFT  &none     &msc SCRL_RIGHT  &none   &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none           &none     &none            &none   &none
            >;
        };
    };
};
